<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.GameOverController">
   <children>
      <Pane prefHeight="720.0" prefWidth="1080.0">
         <children>
            <ImageView fitHeight="720.0" fitWidth="1080.0" layoutY="0.0" preserveRatio="true">
              <image>
                  <Image url="@../images/gameover.png" />
              </image>
            </ImageView>
            <Button fx:id="btnRestartGame" layoutX="437.0" layoutY="519.0" mnemonicParsing="false" onAction="#onBtnRestartGame" prefHeight="67.0" prefWidth="207.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 30px; -fx-border-width: 0; -fx-font-size: 18px;" text="Restart Game" />
            <Label layoutX="251.0" layoutY="433.0" text="You did not make a verdict on time" textFill="WHITE">
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
         </children></Pane>
   </children>
</StackPane>
