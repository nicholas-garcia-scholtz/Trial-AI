          <Image url="@../images/AIArtistFlashback.png" />
      </image>
    </ImageView>
      <TextArea fx:id="chatLog" editable="false" layoutX="600.0" prefHeight="385.0" prefWidth="200.0" style="-fx-control-inner-background: #000000; -fx-text-fill: #3aff47;" wrapText="true" />
      <TextField fx:id="userTextBox" alignment="TOP_LEFT" layoutX="600.0" layoutY="385.0" prefHeight="75.0" prefWidth="200.0" promptText="Talk to the AI art critic" style="-fx-control-inner-background: #000000; -fx-text-fill: #3aff47; -fx-border-color: #3aff47; -fx-prompt-text-fill: #3aff47; -fx-border-width: 2px; -fx-background-radius: 5;" />
      <Button fx:id="btnSend" layoutX="600.0" layoutY="460.0" mnemonicParsing="false" onAction="#onBtnSendClicked" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #000000; -fx-text-fill: #3aff47;" text="Send">
